{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://co-working-platform-carlos-tello-alvarado.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://co-working-platform-carlos-tello-alvarado.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api|uploads|.*\\..*).*)",
      "destination": "/"
    }
  ]
}
